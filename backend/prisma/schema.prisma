generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  name      String
  email     String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders          Sender[]
  campaigns        Campaign[]
  slackConnections SlackConnection[]
}

model Sender {
  id           String   @id @default(uuid())
  userId       String
  email        String
  smtpHost     String
  smtpPort     Int
  smtpUser     String
  smtpPassword String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@index([userId])
}

model Campaign {
  id          String   @id @default(uuid())
  userId      String
  subject     String
  body        String
  startTime   DateTime
  delayMs     Int
  hourlyLimit Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@index([userId])
}

model Email {
  id           String   @id @default(uuid())
  campaignId   String
  senderId     String
  recipient    String
  subject      String
  body         String
  scheduledAt  DateTime
  sentAt       DateTime?
  status       EmailStatus @default(SCHEDULED)
  bullJobId    String   @unique
  attempts     Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id])

  @@index([campaignId])
  @@index([senderId])
  @@index([status])
  @@index([scheduledAt])
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model SlackConnection {
  id           String   @id @default(uuid())
  userId       String
  slackUserId  String?
  teamId       String?
  accessToken  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
